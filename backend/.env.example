# =========================================================================
#  REQUIRED  — the app will refuse to start without these.
# =========================================================================

# Master key used to encrypt EVERY user's API keys at rest (Fernet).
# Generate ONE, keep it secret, NEVER commit it. If you lose it, all stored
# user keys become unreadable (users just re-enter them).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# Secret used to sign login tokens (JWT). Long random string.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# =========================================================================
#  OPTIONAL  — sensible defaults already applied.
# =========================================================================

# Where the SQLite database lives. Default: backend/data/app.db
# DATABASE_URL=sqlite:////absolute/path/to/app.db

# Comma-separated frontend origins allowed to call this API
# (your local dev server + your deployed Netlify URL).
ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# How long a login stays valid, in minutes. Default = 14 days.
# JWT_EXPIRE_MINUTES=20160

# Apify actor used to fetch LinkedIn posts.
APIFY_ACTOR=harvestapi/linkedin-profile-posts

# Default Gemini model assigned to new users.
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
